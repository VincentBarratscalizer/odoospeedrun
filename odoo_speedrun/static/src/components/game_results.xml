<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.GameResults">
        <div class="o_speedrun_results text-center">
            <!-- Winner announcement -->
            <div class="mb-4">
                <t t-if="isWinner">
                    <h1 class="display-3 fw-bold text-warning mb-2">YOU WIN!</h1>
                    <p class="fs-3 text-success">Congratulations, speedrunner!</p>
                </t>
                <t t-else="">
                    <h1 class="display-4 fw-bold text-info mb-2">Game Over</h1>
                    <p class="fs-4">
                        Winner: <span class="text-warning fw-bold"><t t-esc="props.game.winner_name"/></span>
                    </p>
                </t>
            </div>

            <!-- Task reminder -->
            <div class="mb-4">
                <span class="badge bg-secondary fs-6 px-3 py-2">
                    Task: <t t-esc="props.game.task_name"/>
                </span>
            </div>

            <!-- Results table -->
            <div class="card bg-secondary bg-opacity-25 border-light mb-4" style="max-width: 600px; margin: 0 auto;">
                <div class="card-body p-0">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 60px;">Rank</th>
                                <th>Player</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="results" t-as="result" t-key="result.user_id">
                                <tr t-att-class="result.user_id === props.userId ? 'table-active' : ''">
                                    <td class="text-center fs-4">
                                        <t t-esc="getRankEmoji(result_index)"/>
                                    </td>
                                    <td class="align-middle">
                                        <span class="fw-bold"><t t-esc="result.user_name"/></span>
                                        <t t-if="result.user_id === props.userId">
                                            <span class="badge bg-info ms-1">You</span>
                                        </t>
                                    </td>
                                    <td class="text-center align-middle">
                                        <t t-if="result.state === 'finished'">
                                            <span class="badge bg-success">Finished</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-danger">DNF</span>
                                        </t>
                                    </td>
                                    <td class="text-end align-middle font-monospace">
                                        <t t-esc="formatTime(result.duration_ms)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <button class="btn btn-warning btn-lg fw-bold px-5" t-on-click="() => this.props.onPlayAgain()">
                Play Again
            </button>
        </div>
    </t>
</templates>
