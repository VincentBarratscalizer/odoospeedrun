<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.GameTimeAttack">
        <div class="o_speedrun_time_attack">

            <!-- Timer banner -->
            <div class="card mb-4 text-center border-0 shadow-sm"
                 t-att-style="localState.timeLeft <= 10 ? 'background: #fff5f5;' : localState.timeLeft <= 30 ? 'background: #fffbf0;' : ''">
                <div class="card-body py-3">
                    <div class="small text-uppercase text-muted mb-1 fw-bold">Time Remaining</div>
                    <div class="display-3 fw-bold font-monospace" t-att-class="timerClass">
                        <t t-esc="timeDisplay"/>
                    </div>
                    <t t-if="!isTimeUp">
                        <div class="small text-muted mt-1">
                            ⏱ Complete as many tasks as you can!
                        </div>
                    </t>
                    <t t-else="">
                        <div class="small text-danger fw-bold mt-1">
                            Time's up!
                            <t t-if="!props.isHost"> Waiting for results...</t>
                        </div>
                    </t>
                </div>
            </div>

            <div class="row g-4">
                <!-- Left: current task -->
                <div class="col-lg-7">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <i class="fa fa-tasks me-2"/>Your Current Task
                            </span>
                            <span class="badge text-bg-info">
                                <t t-esc="myCount"/> done
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-center p-4 text-center">
                            <t t-if="isTimeUp">
                                <div class="text-muted">
                                    <i class="fa fa-flag-checkered fa-3x mb-3"/>
                                    <h4>Time's up!</h4>
                                    <p>You completed <strong><t t-esc="myCount"/></strong> task<t t-if="myCount !== 1">s</t>.</p>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-if="localState.currentTaskName">
                                    <div class="small text-uppercase text-muted mb-2 fw-bold">Task</div>
                                    <h3 class="mb-3">
                                        <t t-esc="localState.currentTaskName"/>
                                    </h3>
                                    <t t-if="localState.currentTaskDesc">
                                        <p class="text-muted mb-4">
                                            <t t-esc="localState.currentTaskDesc"/>
                                        </p>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="text-muted mb-4">
                                        <i class="fa fa-spinner fa-spin me-2"/>Loading task...
                                    </div>
                                </t>

                                <!-- Check result feedback -->
                                <t t-if="localState.checkResult">
                                    <t t-if="localState.checkResult.success">
                                        <div class="alert alert-success py-2 mb-3">
                                            ✅ Task done! Next task loaded.
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-warning py-2 mb-3">
                                            ⚠️ <t t-esc="localState.checkResult.error or 'Not completed yet.'"/>
                                        </div>
                                    </t>
                                </t>

                                <button
                                    class="btn btn-success btn-lg px-5"
                                    t-att-disabled="localState.checking or isTimeUp"
                                    t-on-click="onCheckCompletion">
                                    <t t-if="localState.checking">
                                        <i class="fa fa-spinner fa-spin me-2"/>Checking...
                                    </t>
                                    <t t-else="">
                                        ✅ I'm Done!
                                    </t>
                                </button>
                                <div class="small text-muted mt-3">
                                    Go to Odoo, complete the task above, then come back and click "I'm Done!"
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Right: live leaderboard -->
                <div class="col-lg-5">
                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            <i class="fa fa-list-ol me-2"/>Live Leaderboard
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush">
                                <t t-foreach="sortedPlayers" t-as="player" t-key="player.user_id">
                                    <div class="list-group-item d-flex justify-content-between align-items-center"
                                         t-att-class="player.user_id === props.userId ? 'list-group-item-info fw-bold' : ''">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge text-bg-secondary rounded-circle"
                                                  style="width:1.6em;height:1.6em;line-height:1.6em;text-align:center;">
                                                <t t-esc="player_index + 1"/>
                                            </span>
                                            <span>
                                                <t t-esc="player.user_name"/>
                                                <t t-if="player.user_id === props.userId">
                                                    <span class="badge text-bg-info ms-1">You</span>
                                                </t>
                                            </span>
                                        </div>
                                        <span class="badge text-bg-success fs-6 px-3">
                                            <t t-esc="player.ta_completed_count || 0"/> ✓
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
