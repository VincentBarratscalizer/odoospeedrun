#. module: speedrun_purchase
#: model:speedrun.task,description:speedrun_purchase.task_create_purchase_order
msgid "Create a new purchase order (Request for Quotation) for any vendor with at least one product line."
msgstr "Créez un nouveau bon de commande (demande de prix) pour n'importe quel fournisseur avec au moins une ligne de produit."

#. module: speedrun_purchase
#: model:speedrun.task,name:speedrun_purchase.task_create_purchase_order
msgid "Create a purchase order"
msgstr "Créer un bon de commande"

#. module: speedrun_purchase
#: model:speedrun.task,description:speedrun_purchase.task_confirm_purchase_order
msgid "Create a purchase order and confirm it. The order must be in \"Purchase Order\" state (not just a draft RFQ)."
msgstr "Créez un bon de commande et confirmez-le. La commande doit être à l'état « Bon de commande » (pas seulement une demande de prix en brouillon)."

#. module: speedrun_purchase
#: model:speedrun.task,name:speedrun_purchase.task_confirm_purchase_order
msgid "Confirm a purchase order"
msgstr "Confirmer un bon de commande"

#. module: speedrun_purchase
#: model:speedrun.task,description:speedrun_purchase.task_purchase_to_receipt
msgid "Create a purchase order, confirm it, then go to the receipt and validate it. Full purchase cycle!"
msgstr "Créez un bon de commande, confirmez-le, puis allez à la réception et validez-la. Cycle d'achat complet !"

#. module: speedrun_purchase
#: model:speedrun.task,name:speedrun_purchase.task_purchase_to_receipt
msgid "Purchase and receive goods"
msgstr "Acheter et réceptionner des marchandises"

#. module: speedrun_purchase
#: model:speedrun.task.group,name:speedrun_purchase.group_purchase
msgid "Purchase"
msgstr "Achats"
