<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default 7-day login-reward cycles. Managers can edit / add more;
         each new player cycle is drawn at random among the active ones. -->

    <!-- Cycle A: steady climb of chests, equipment on day 7 -->
    <record id="loot_seq_climb" model="speedrun.loot.sequence">
        <field name="name">Ascension</field>
        <field name="sequence">10</field>
    </record>
    <record id="loot_seq_climb_d1" model="speedrun.loot.sequence.day">
        <field name="sequence_id" ref="loot_seq_climb"/><field name="day">1</field>
        <field name="reward_type">chest</field><field name="chest_rarity">common</field><field name="coins">50</field>
    </record>
    <record id="loot_seq_climb_d2" model="speedrun.loot.sequence.day">
        <field name="sequence_id" ref="loot_seq_climb"/><field name="day">2</field>
        <field name="reward_type">chest</field><field name="chest_rarity">common</field><field name="coins">80</field>
    </record>
    <record id="loot_seq_climb_d3" model="speedrun.loot.sequence.day">
        <field name="sequence_id" ref="loot_seq_climb"/><field name="day">3</field>
        <field name="reward_type">chest</field><field name="chest_rarity">rare</field>
    </record>
    <record id="loot_seq_climb_d4" model="speedrun.loot.sequence.day">
