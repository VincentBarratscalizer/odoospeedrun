#. module: speedrun_pos
#: model:speedrun.task,description:speedrun_pos.task_pos_product
msgid "Create a new product and make it available in the Point of Sale (check \"Available in POS\")."
msgstr "Créez un nouveau produit et rendez-le disponible dans le Point de Vente (cochez « Disponible en PdV »)."

#. module: speedrun_pos
#: model:speedrun.task,name:speedrun_pos.task_pos_product
msgid "Make a product available in POS"
msgstr "Rendre un produit disponible en PdV"

#. module: speedrun_pos
#: model:speedrun.task,description:speedrun_pos.task_open_pos_session
msgid "Open a new session in the Point of Sale app (click \"Open Register\" on any POS)."
msgstr "Ouvrez une nouvelle session dans l'application Point de Vente (cliquez sur « Ouvrir la caisse » sur un PdV)."

#. module: speedrun_pos
#: model:speedrun.task,name:speedrun_pos.task_open_pos_session
msgid "Open a POS session"
msgstr "Ouvrir une session PdV"

#. module: speedrun_pos
#: model:speedrun.task,description:speedrun_pos.task_restaurant_floor
msgid "Create a restaurant floor plan with at least 4 tables (POS > Configuration > Floor Plans)."
msgstr "Créez un plan de salle de restaurant avec au moins 4 tables (PdV > Configuration > Plans de salle)."

#. module: speedrun_pos
#: model:speedrun.task,name:speedrun_pos.task_restaurant_floor
msgid "Create a restaurant floor with 4 tables"
msgstr "Créer un plan de salle de restaurant avec 4 tables"
