            <field name="required_modules">room</field>
        </record>

        <record id="task_book_room" model="speedrun.task">
            <field name="name">Book a meeting room</field>
            <field name="description">Create a booking for a room in the Rooms app.</field>
            <field name="target_model">room.booking</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">medium</field>
            <field name="required_modules">room</field>
        </record>

        <record id="task_create_frontdesk_station" model="speedrun.task">
            <field name="name">Create a frontdesk station</field>
            <field name="description">Create a new station in the Frontdesk app with a name.</field>
            <field name="target_model">frontdesk.frontdesk</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">medium</field>
            <field name="required_modules">frontdesk</field>
        </record>

        <record id="task_create_sign_template" model="speedrun.task">
            <field name="name">Upload a document to sign</field>
            <field name="description">Upload a PDF document in the Sign app to create a new template.</field>
            <field name="target_model">sign.template</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">hard</field>
            <field name="required_modules">sign</field>
        </record>
    </data>
</odoo>
