<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_speedrun" model="ir.module.category">
        <field name="name">Speedrun</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_speedrun" model="res.groups.privilege">
        <field name="name">Speedrun</field>
        <field name="category_id" ref="module_category_speedrun"/>
        <field name="sequence">100</field>
    </record>

    <!-- Keep player group for backward compat, all internal users are players -->
    <record id="group_speedrun_player" model="res.groups">
        <field name="name">Player</field>
        <field name="privilege_id" ref="privilege_speedrun"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_speedrun_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_speedrun"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record rules: all internal users can read games, write their own -->
    <record id="speedrun_game_rule_read" model="ir.rule">
        <field name="name">Speedrun Game: read all</field>
        <field name="model_id" ref="model_speedrun_game"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="speedrun_game_rule_write" model="ir.rule">
        <field name="name">Speedrun Game: write own games</field>
        <field name="model_id" ref="model_speedrun_game"/>
        <field name="domain_force">['|', ('host_id', '=', user.id), ('player_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
