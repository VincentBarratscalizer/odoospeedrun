<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.GameTimer">
        <div class="o_speedrun_timer text-center">
            <!-- Task card -->
            <div class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-2">Your Mission</h6>
                    <h3 class="mb-3">
                        <t t-esc="props.game.task_name"/>
                    </h3>
                    <p class="text-muted mb-0" t-if="props.game.task_description">
                        <t t-esc="props.game.task_description"/>
                    </p>
                </div>
            </div>

            <!-- Timer display -->
            <div class="o_speedrun_timer_display mb-4">
                <div class="display-3 font-monospace fw-bold">
                    <t t-esc="timerState.elapsed"/>
                </div>
            </div>

            <!-- Action buttons -->
            <t t-if="!props.myFinished">
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button class="btn btn-lg px-5"
                        title="Check task completion (Alt+Shift+D)"
                        t-att-class="timerState.checking ? 'btn-secondary' : 'btn-primary'"
                        t-att-disabled="timerState.checking or timerState.surrendering"
                        t-on-click="onClickCheck">
                        <t t-if="timerState.checking">
                            Checking...
                        </t>
                        <t t-else="">
                            I'm Done!
                        </t>
                    </button>
                    <button class="btn btn-lg btn-outline-danger px-4"
                        title="Surrender this round — score no points (Alt+Shift+S)"
                        t-att-disabled="timerState.checking or timerState.surrendering"
                        t-on-click="onClickSurrender">
                        <i class="fa fa-flag me-1"/>
                        <t t-if="timerState.surrendering">
                            Surrendering...
                        </t>
                        <t t-else="">
                            Surrender
                        </t>
                    </button>
                </div>
                <t t-if="props.checkResult and !props.checkResult.success and props.checkResult.error">
                    <div class="alert alert-warning mt-3 d-inline-block">
                        <t t-esc="props.checkResult.error"/>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="alert alert-success d-inline-block px-5">
                    Task completed! Waiting for other players...
                </div>
            </t>

            <!-- Players status -->
            <div class="mt-4">
                <h6 class="text-muted">Players</h6>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <t t-foreach="props.game.players" t-as="player" t-key="player.user_id">
                        <!-- In BR, don't show eliminated players -->
                        <t t-if="props.game.game_mode !== 'battle_royale' or (player.lives_remaining || 0) > 0">
                            <div class="card" style="min-width: 150px;">
                                <div class="card-body p-3 text-center">
                                    <div class="fw-bold mb-1"><t t-esc="player.user_name"/></div>
                                    <t t-if="props.game.game_mode === 'battle_royale'">
                                        <div class="small mb-1">
                                            <t t-esc="'❤️'.repeat(Math.min(player.lives_remaining || 0, 5))"/>
                                            <t t-if="(player.lives_remaining || 0) > 5">×<t t-esc="player.lives_remaining"/></t>
                                        </div>
                                    </t>
                                    <t t-if="player.state === 'finished'">
                                        <span class="badge text-bg-success">Done!</span>
                                    </t>
                                    <t t-elif="player.state === 'playing'">
                                        <span class="badge text-bg-info">Playing...</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge text-bg-secondary"><t t-esc="player.state"/></span>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
