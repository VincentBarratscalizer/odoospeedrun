<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.DailyChallenge">
        <div class="o_speedrun_daily card mb-4 border-warning">

            <!-- Header -->
            <div class="card-header d-flex justify-content-between align-items-center bg-warning bg-opacity-10">
                <span class="fw-bold">
                    <i class="fa fa-calendar-check-o me-2 text-warning"/>Daily Challenge
                    <t t-if="state.daily">
                        <span class="badge text-bg-warning ms-2 fw-normal">
                            <t t-esc="state.daily.date"/>
                        </span>
                    </t>
                </span>
                <t t-if="state.daily and state.daily.completion_count > 0">
                    <button class="btn btn-sm btn-outline-warning" t-on-click="toggleLeaderboard">
                        <i class="fa fa-trophy me-1"/>
                        <t t-esc="state.daily.completion_count"/> completed
                        <i t-att-class="state.showLeaderboard ? 'fa fa-chevron-up ms-1' : 'fa fa-chevron-down ms-1'"/>
                    </button>
                </t>
            </div>

            <div class="card-body">

                <!-- Loading -->
                <t t-if="state.phase === 'loading'">
                    <div class="text-center text-muted py-3">
                        <i class="fa fa-spinner fa-spin me-2"/>Loading today's challenge...
                    </div>
                </t>

                <!-- Error -->
                <t t-if="state.phase === 'error'">
                    <div class="text-center text-muted py-3">
                        No daily challenge available today.
                    </div>
                </t>

                <!-- Not started -->
                <t t-if="state.phase === 'not_started' and state.daily">
                    <div class="text-center">
                        <h5 class="mb-1"><t t-esc="state.daily.task_name"/></h5>
                        <p class="text-muted small mb-3" t-if="state.daily.task_description">
                            <t t-esc="state.daily.task_description"/>
                        </p>
                        <p class="text-muted small mb-3">
                            One attempt per day. Your timer starts the moment you click — good luck!
                        </p>
                        <button class="btn btn-warning btn-lg px-5" t-on-click="onClickStart">
                            <i class="fa fa-play me-2"/>Start Daily Challenge
                        </button>
                    </div>
                </t>

                <!-- In progress -->
                <t t-if="state.phase === 'in_progress' and state.daily">
                    <div class="text-center">
                        <div class="text-muted small text-uppercase mb-1">Your mission</div>
                        <h5 class="mb-1"><t t-esc="state.daily.task_name"/></h5>
                        <p class="text-muted small mb-3" t-if="state.daily.task_description">
                            <t t-esc="state.daily.task_description"/>
                        </p>
                        <div class="display-6 font-monospace fw-bold text-warning mb-3">
                            <t t-esc="state.elapsed"/>
                        </div>
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-warning btn-lg px-5"
                                t-att-disabled="state.checking"
                                t-on-click="onClickCheck">
                                <t t-if="state.checking">
                                    <i class="fa fa-spinner fa-spin me-2"/>Checking...
                                </t>
                                <t t-else="">
                                    <i class="fa fa-check me-2"/>I'm Done!
                                </t>
                            </button>
                        </div>
                        <p class="text-muted small mt-2">
                            Go to Odoo, complete the task, then come back here to submit.
                        </p>
                    </div>
                </t>

                <!-- Completed -->
                <t t-if="state.phase === 'completed' and state.daily">
                    <div class="text-center">
                        <div class="mb-2">
                            <span class="display-4"><t t-esc="myRankDisplay"/></span>
                        </div>
                        <h5 class="mb-1"><t t-esc="state.daily.task_name"/></h5>
                        <div class="display-6 font-monospace fw-bold text-success mb-1">
                            <t t-esc="formatTime(state.daily.my_duration_ms)"/>
                        </div>
                        <div class="text-muted small">
                            Rank <strong><t t-esc="state.daily.my_rank"/></strong>
                            of <strong><t t-esc="state.daily.completion_count"/></strong>
                        </div>
                    </div>
                </t>

                <!-- Weekly reward track (7-day login streak) -->
                <t t-if="state.daily and state.daily.weekly_reward">
                    <hr class="my-3"/>
                    <div class="small fw-bold text-muted mb-2 text-uppercase">
                        🎁 Récompenses de la semaine
                        <t t-if="state.daily.weekly_reward.known and state.daily.weekly_reward.sequence_name">
                            <span class="text-warning">· <t t-esc="state.daily.weekly_reward.sequence_name"/></span>
                        </t>
                    </div>
                    <div class="o_daily_reward_track d-flex gap-1">
                        <t t-foreach="state.daily.weekly_reward.days" t-as="d" t-key="d.day">
                            <div class="o_reward_slot flex-fill text-center"
                                 t-att-class="(d.claimed ? 'o_claimed ' : '') + (d.is_next ? 'o_next' : '')">
                                <div class="o_reward_day small text-muted">J<t t-esc="d.day"/></div>
                                <div class="o_reward_icon"><t t-esc="d.icon"/></div>
                                <div class="o_reward_label small text-truncate" t-att-title="d.label"><t t-esc="d.label"/></div>
                                <div t-if="d.coins" class="o_reward_coins small text-muted">+<t t-esc="d.coins"/>💰</div>
                                <div t-if="d.claimed" class="o_reward_check">✔</div>
                            </div>
                        </t>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        Complétez la Daily chaque jour pour avancer dans ce cycle. Manquer un jour relance un nouveau cycle (affiché ci-dessus).
                    </p>
                </t>

                <!-- Leaderboard (collapsible) -->
                <t t-if="state.showLeaderboard and state.daily and state.daily.leaderboard.length">
                    <hr class="my-3"/>
                    <div class="small fw-bold text-muted mb-2 text-uppercase">
                        <i class="fa fa-trophy me-1 text-warning"/>Today's Leaderboard
                    </div>
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:50px;">Rank</th>
                                <th>Player</th>
                                <th class="text-end">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.daily.leaderboard" t-as="entry" t-key="entry.user_id">
                                <tr t-att-class="entry.user_id === user.userId ? 'table-warning fw-bold' : ''">
                                    <td class="text-center">
                                        <t t-esc="getRankEmoji(entry.rank)"/>
                                    </td>
                                    <td>
                                        <t t-esc="entry.user_name"/>
                                        <t t-if="entry.user_id === user.userId">
                                            <span class="badge text-bg-warning ms-1">You</span>
                                        </t>
                                    </td>
                                    <td class="text-end font-monospace">
                                        <t t-esc="formatTime(entry.duration_ms)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

            </div>
        </div>
    </t>
</templates>
