#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_employee
msgid "Create a new employee with a name, a job title, and a work email address."
msgstr "Créez un nouvel employé avec un nom, un intitulé de poste et une adresse email professionnelle."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_employee
msgid "Create an employee"
msgstr "Créer un employé"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_3_employees
msgid "Create 3 new employees. Each one just needs a name - be fast!"
msgstr "Créez 3 nouveaux employés. Chacun n'a besoin que d'un nom - soyez rapide !"

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_3_employees
msgid "Create 3 employees"
msgstr "Créer 3 employés"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_leave_request
msgid "Create a time off request (leave) for any employee. Go to Time Off and create a new request."
msgstr "Créez une demande de congé pour n'importe quel employé. Allez dans Congés et créez une nouvelle demande."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_leave_request
msgid "Create a leave request"
msgstr "Créer une demande de congé"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_log_expense
msgid "Create a new expense with a description and an amount. Go to Expenses and click \"New\"."
msgstr "Créez une nouvelle note de frais avec une description et un montant. Allez dans Notes de frais et cliquez sur « Nouveau »."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_log_expense
msgid "Log an expense"
msgstr "Enregistrer une note de frais"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_log_3_expenses
msgid "Create 3 separate expense entries. Each needs a description and an amount."
msgstr "Créez 3 notes de frais distinctes. Chacune nécessite une description et un montant."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_log_3_expenses
msgid "Log 3 expenses"
msgstr "Enregistrer 3 notes de frais"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_vehicle
msgid "Create a new vehicle in the Fleet app. Pick any model and give it a license plate."
msgstr "Créez un nouveau véhicule dans l'application Parc automobile. Choisissez un modèle et attribuez-lui une plaque d'immatriculation."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_vehicle
msgid "Register a vehicle"
msgstr "Enregistrer un véhicule"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_vehicle_with_driver
msgid "Create a vehicle in the Fleet app and assign a driver to it."
msgstr "Créez un véhicule dans l'application Parc automobile et affectez-lui un conducteur."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_vehicle_with_driver
msgid "Assign a driver to a vehicle"
msgstr "Affecter un conducteur à un véhicule"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_job_position
msgid "Create a new job position in the Recruitment app."
msgstr "Créez un nouveau poste dans l'application Recrutement."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_job_position
msgid "Create a job position"
msgstr "Créer un poste"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_applicant
msgid "Create a new applicant in the Recruitment app with a name and an email address."
msgstr "Créez un nouveau candidat dans l'application Recrutement avec un nom et une adresse email."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_applicant
msgid "Register a job applicant"
msgstr "Enregistrer un candidat"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_attendance
msgid "Create an attendance record (check-in) for any employee from the Attendances app."
msgstr "Créez un enregistrement de présence (entrée) pour n'importe quel employé depuis l'application Présences."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_attendance
msgid "Log an attendance entry"
msgstr "Enregistrer une présence"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_attendance_check_out
msgid "Create an attendance record with both a check-in AND a check-out time."
msgstr "Créez un enregistrement de présence avec une heure d'entrée ET une heure de sortie."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_attendance_check_out
msgid "Log a complete attendance (in and out)"
msgstr "Enregistrer une présence complète (entrée et sortie)"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_appraisal
msgid "Create a new appraisal for any employee in the Appraisals app."
msgstr "Créez une nouvelle évaluation pour n'importe quel employé dans l'application Évaluations."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_appraisal
msgid "Create an appraisal"
msgstr "Créer une évaluation"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_add_employee_skill
msgid "Open an employee's profile and add a skill (e.g. a language or IT skill) in the Resume tab."
msgstr "Ouvrez la fiche d'un employé et ajoutez une compétence (ex. une langue ou une compétence informatique) dans l'onglet CV."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_add_employee_skill
msgid "Add a skill to an employee"
msgstr "Ajouter une compétence à un employé"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_payslip_batch
msgid "Create a new payslip batch in the Payroll app with a name and a period."
msgstr "Créez un nouveau lot de bulletins de paie dans l'application Paie avec un nom et une période."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_payslip_batch
msgid "Create a payslip batch"
msgstr "Créer un lot de bulletins de paie"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_approval
msgid "Create a new approval request in the Approvals app (any category, e.g. Business Trip)."
msgstr "Créez une nouvelle demande d'approbation dans l'application Approbations (toute catégorie, ex. Voyage d'affaires)."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_approval
msgid "Create an approval request"
msgstr "Créer une demande d'approbation"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_submit_approval
msgid "Create an approval request and submit it. It must no longer be in the \"To Submit\" state."
msgstr "Créez une demande d'approbation et soumettez-la. Elle ne doit plus être à l'état « À soumettre »."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_submit_approval
msgid "Submit an approval request"
msgstr "Soumettre une demande d'approbation"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_lunch_vendor
msgid "Create a new vendor in the Lunch app configuration."
msgstr "Créez un nouveau fournisseur dans la configuration de l'application Repas."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_lunch_vendor
msgid "Create a lunch vendor"
msgstr "Créer un fournisseur de repas"

#. module: speedrun_hr
#: model:speedrun.task,description:speedrun_hr.task_create_lunch_products
msgid "Create 3 products in the Lunch app (each needs a name, a category, a vendor and a price)."
msgstr "Créez 3 produits dans l'application Repas (chacun nécessite un nom, une catégorie, un fournisseur et un prix)."

#. module: speedrun_hr
#: model:speedrun.task,name:speedrun_hr.task_create_lunch_products
msgid "Create 3 lunch products"
msgstr "Créer 3 produits de repas"
