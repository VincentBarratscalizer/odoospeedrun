#. module: speedrun_inventory
#: model:speedrun.task,description:speedrun_inventory.task_create_delivery
msgid "Create a new delivery order (outgoing shipment) from the Inventory app. Add at least one product to ship."
msgstr "Créez un nouveau bon de livraison (expédition sortante) depuis l'application Inventaire. Ajoutez au moins un produit à expédier."

#. module: speedrun_inventory
#: model:speedrun.task,name:speedrun_inventory.task_create_delivery
msgid "Create a delivery order"
msgstr "Créer un bon de livraison"

#. module: speedrun_inventory
#: model:speedrun.task,description:speedrun_inventory.task_create_receipt
msgid "Create a new receipt (incoming shipment) from the Inventory app. You're receiving goods into your warehouse."
msgstr "Créez une nouvelle réception (arrivage entrant) depuis l'application Inventaire. Vous recevez des marchandises dans votre entrepôt."

#. module: speedrun_inventory
#: model:speedrun.task,name:speedrun_inventory.task_create_receipt
msgid "Create a receipt"
msgstr "Créer une réception"

#. module: speedrun_inventory
#: model:speedrun.task,description:speedrun_inventory.task_validate_receipt
msgid "Create an incoming receipt and validate it (mark it as done). The transfer must be in \"Done\" state."
msgstr "Créez une réception entrante et validez-la (marquez-la comme faite). Le transfert doit être à l'état « Fait »."

#. module: speedrun_inventory
#: model:speedrun.task,name:speedrun_inventory.task_validate_receipt
msgid "Validate a receipt"
msgstr "Valider une réception"

#. module: speedrun_inventory
#: model:speedrun.task,description:speedrun_inventory.task_barcode_product
msgid "Create a new product and assign it a barcode (any code, e.g. 1234567890128)."
msgstr "Créez un nouveau produit et attribuez-lui un code-barres (n'importe quel code, ex. 1234567890128)."

#. module: speedrun_inventory
#: model:speedrun.task,name:speedrun_inventory.task_barcode_product
msgid "Set a barcode on a product"
msgstr "Définir un code-barres sur un produit"

#. module: speedrun_inventory
#: model:speedrun.task.group,name:speedrun_inventory.group_inventory
msgid "Inventory"
msgstr "Inventaire"
