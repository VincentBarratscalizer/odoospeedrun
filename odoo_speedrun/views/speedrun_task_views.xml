<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="speedrun_task_view_tree" model="ir.ui.view">
        <field name="name">speedrun.task.tree</field>
        <field name="model">speedrun.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="target_model"/>
                <field name="difficulty" decoration-success="difficulty == 'easy'" decoration-warning="difficulty == 'medium'" decoration-danger="difficulty == 'hard'" widget="badge"/>
                <field name="verification_method"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="speedrun_task_view_form" model="ir.ui.view">
        <field name="name">speedrun.task.form</field>
        <field name="model">speedrun.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Task Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="difficulty"/>
                            <field name="target_model"/>
                            <field name="required_modules"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="verification_method"/>
                            <field name="verification_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Verification Domain" invisible="verification_method != 'domain'">
                            <field name="verification_domain" widget="ace" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Verification Code" invisible="verification_method != 'python'">
                            <field name="verification_code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_task_action" model="ir.actions.act_window">
        <field name="name">Speedrun Tasks</field>
        <field name="res_model">speedrun.task</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
