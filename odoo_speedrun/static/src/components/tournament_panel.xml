<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.TournamentPanel">
        <div class="o_speedrun_tournaments w-100">

            <!-- ============ LIST VIEW ============ -->
            <t t-if="!t">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button class="btn btn-link" t-on-click="() => props.onBack()">
                        <i class="fa fa-arrow-left me-1"/>Back to Arena
                    </button>
                    <button class="btn btn-primary"
                        t-on-click="() => this.formState.showCreate = !this.formState.showCreate">
                        <i class="fa fa-plus me-1"/>New Tournament
                    </button>
                </div>

                <!-- Create form -->
                <t t-if="formState.showCreate">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Create a Tournament</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Name</label>
                                    <input type="text" class="form-control"
                                        placeholder="Tournament name (optional)"
                                        t-model="formState.name"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Match Format</label>
                                    <select class="form-select" t-model="formState.matchBestOf">
                                        <option value="3">Best of 3</option>
                                        <option value="5">Best of 5</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Seeding</label>
                                    <select class="form-select" t-model="formState.seedingMethod">
                                        <option value="elo">By ELO</option>
                                        <option value="random">Random</option>
                                        <option value="manual">Manual</option>
                                    </select>
                                </div>
                            </div>
                            <div class="text-muted small mt-2">
                                Double elimination · 1v1 best-of series · seeded bracket.
                            </div>
                            <button class="btn btn-primary mt-3" t-on-click="onClickCreate">
                                Create &amp; Open Registration
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Tournament list -->
                <t t-if="props.tournaments and props.tournaments.length">
                    <div class="list-group">
                        <t t-foreach="props.tournaments" t-as="tour" t-key="tour.id">
                            <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                t-on-click="() => props.onOpen(tour.id)">
                                <div>
                                    <span class="fw-bold me-2"><t t-esc="tour.name"/></span>
                                    <span class="badge" t-att-class="stateBadge(tour.state)">
                                        <t t-esc="stateLabel(tour.state)"/>
                                    </span>
                                    <t t-if="tour.is_registered">
                                        <span class="badge text-bg-success ms-1">Registered</span>
                                    </t>
                                    <div class="text-muted small mt-1">
                                        by <t t-esc="tour.organizer_name"/> ·
                                        Best of <t t-esc="tour.match_best_of"/> ·
                                        <t t-esc="tour.participant_count"/>
                                        <t t-if="tour.max_participants"> / <t t-esc="tour.max_participants"/></t> players
                                        <t t-if="tour.winner_name"> · 🏆 <t t-esc="tour.winner_name"/></t>
                                    </div>
                                </div>
                                <i class="fa fa-chevron-right text-muted"/>
                            </button>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-trophy fa-3x mb-3 d-block opacity-50"/>
                        No tournaments yet. Create one to get started!
                    </div>
                </t>
            </t>

            <!-- ============ DETAIL VIEW ============ -->
            <t t-else="">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button class="btn btn-link" t-on-click="() => props.onOpen(null)">
                        <i class="fa fa-arrow-left me-1"/>All Tournaments
                    </button>
                    <button t-if="props.onRefresh" class="btn btn-light btn-sm"
                        t-on-click="() => props.onRefresh()">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>

                <!-- Header -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="mb-1">
                                    <t t-esc="t.name"/>
                                    <span class="badge ms-2" t-att-class="stateBadge(t.state)">
                                        <t t-esc="stateLabel(t.state)"/>
                                    </span>
                                </h3>
                                <p class="text-muted mb-0">
                                    Organizer: <span class="fw-bold"><t t-esc="t.organizer_name"/></span>
                                    · <span class="badge text-bg-secondary">Best of <t t-esc="t.match_best_of"/></span>
                                    · Double elimination
                                </p>
                            </div>
                            <div class="text-end">
                                <t t-if="t.state === 'finished' and t.winner_name">
                                    <div class="h4 mb-0">🏆 <t t-esc="t.winner_name"/></div>
                                    <div class="text-muted small">Runner-up: <t t-esc="t.runner_up_name"/></div>
                                </t>
                            </div>
                        </div>

                        <!-- Registration actions -->
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <t t-if="t.state === 'registration' and !t.is_registered">
                                <button class="btn btn-success" t-on-click="() => props.onRegister()">
                                    <i class="fa fa-user-plus me-1"/>Register
                                </button>
                            </t>
                            <t t-if="['registration','seeding'].includes(t.state) and t.is_registered">
                                <button class="btn btn-outline-danger" t-on-click="() => props.onUnregister()">
                                    <i class="fa fa-user-times me-1"/>Withdraw
                                </button>
                            </t>
                            <t t-if="t.is_organizer and t.state === 'registration'">
                                <button class="btn btn-primary" t-on-click="() => props.onCloseRegistration()">
                                    <i class="fa fa-lock me-1"/>Close Registration &amp; Seed
                                </button>
                            </t>
                            <t t-if="t.is_organizer and t.state === 'seeding'">
                                <button class="btn btn-outline-secondary" t-on-click="() => props.onReopenRegistration()">
                                    <i class="fa fa-unlock me-1"/>Reopen
                                </button>
                                <button class="btn btn-success" t-on-click="() => props.onStart()">
                                    <i class="fa fa-play me-1"/>Generate Bracket &amp; Start
                                </button>
                            </t>
                            <t t-if="t.is_organizer and props.onCancel and t.state !== 'running'">
                                <button class="btn btn-outline-danger ms-auto" t-on-click="() => props.onCancel()">
                                    <i class="fa fa-trash me-1"/>Delete
                                </button>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Participants / Seeding (before running) -->
                <t t-if="['registration','seeding'].includes(t.state)">
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <i class="fa fa-users me-2"/>Participants
                                <span class="badge text-bg-secondary ms-1"><t t-esc="t.participant_count"/></span>
                            </span>
                            <t t-if="canSeed">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" t-on-click="() => props.onAutoSeed('elo')">
                                        Seed by ELO
                                    </button>
                                    <button class="btn btn-outline-secondary" t-on-click="() => props.onAutoSeed('random')">
                                        Randomize
                                    </button>
                                </div>
                            </t>
                        </div>
                        <div class="list-group list-group-flush">
                            <t t-foreach="t.registrations" t-as="reg" t-key="reg.user_id">
                                <div class="list-group-item d-flex align-items-center"
                                     t-att-class="{'bg-body-secondary': reg.is_me}">
                                    <span class="badge text-bg-primary me-3" style="min-width: 2rem;">
                                        #<t t-esc="reg.seed"/>
                                    </span>
                                    <span class="fw-bold"><t t-esc="reg.user_name"/></span>
                                    <t t-if="reg.is_me"><span class="badge text-bg-info ms-2">You</span></t>
                                    <span class="text-muted small ms-3">ELO <t t-esc="reg.elo"/></span>
                                    <t t-if="canSeed">
                                        <div class="btn-group btn-group-sm ms-auto">
                                            <button class="btn btn-light" t-on-click="() => props.onMoveSeed(reg.user_id, 'up')">
                                                <i class="fa fa-arrow-up"/>
                                            </button>
                                            <button class="btn btn-light" t-on-click="() => props.onMoveSeed(reg.user_id, 'down')">
                                                <i class="fa fa-arrow-down"/>
                                            </button>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Bracket (running / finished) -->
                <t t-if="['running','finished'].includes(t.state)">
                    <TournamentBracket
                        bracket="t.bracket"
                        userId="props.userId"
                        onPlayMatch.bind="props.onPlayMatch"
                    />
                </t>
            </t>
        </div>
    </t>
</templates>
