<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_speedrun.SpeedrunClientAction">
        <div class="o_speedrun_container d-flex flex-column align-items-center min-vh-100 bg-dark text-white p-4">
            <div class="o_speedrun_header text-center mb-4">
                <h1 class="display-4 fw-bold">
                    <span class="text-warning">ODOO</span> SPEEDRUN
                </h1>
                <p class="text-muted fs-5">Race to complete Odoo tasks!</p>
            </div>

            <!-- Round indicator -->
            <t t-if="state.game and state.game.current_round > 0 and state.phase !== 'lobby'">
                <div class="mb-3">
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        Round <t t-esc="state.game.current_round"/> / <t t-esc="state.game.total_rounds"/>
                    </span>
                </div>
            </t>

            <!-- Countdown overlay -->
            <t t-if="state.phase === 'countdown'">
                <div class="o_speedrun_countdown position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-90" style="z-index: 9999;">
                    <div class="text-center" style="max-width: 800px;">
                        <t t-if="state.game and state.game.current_round > 0">
                            <div class="fs-4 text-muted mb-2">
                                Round <t t-esc="state.game.current_round"/> / <t t-esc="state.game.total_rounds"/>
                            </div>
                        </t>

                        <!-- Task preview during countdown -->
                        <t t-if="state.game and state.game.task_name">
                            <div class="mb-4 px-4">
                                <div class="fs-6 text-uppercase text-muted mb-2">Your mission</div>
                                <h2 class="text-info fw-bold mb-2">
                                    <t t-esc="state.game.task_name"/>
                                </h2>
                                <p class="text-light fs-5 mb-0" t-if="state.game.task_description" style="opacity: 0.8;">
                                    <t t-esc="state.game.task_description"/>
                                </p>
                            </div>
                        </t>

                        <div class="display-1 fw-bold text-warning o_speedrun_countdown_number" style="font-size: 12rem;">
                            <t t-if="state.countdown > 0"><t t-esc="state.countdown"/></t>
                            <t t-else="">GO!</t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Main content -->
            <div class="o_speedrun_content w-100" style="max-width: 900px;">
                <t t-if="state.phase === 'lobby'">
                    <GameLobby
                        game="state.game"
                        onCreateGame.bind="createGame"
                        onJoinGame.bind="joinGame"
                        onLeaveGame.bind="leaveGame"
                        onStartGame.bind="startGame"
                        userId="user.userId"
                    />
                </t>
                <t t-if="state.phase === 'playing'">
                    <GameTimer
                        game="state.game"
                        myFinished="state.myFinished"
                        checkResult="state.checkResult"
                        onCheckCompletion.bind="checkCompletion"
                    />
                </t>
                <t t-if="state.phase === 'waiting_others'">
                    <div class="text-center">
                        <!-- My result -->
                        <div class="mb-4">
                            <h2 class="text-success fw-bold mb-2">Task Complete!</h2>
                            <div class="fs-1 fw-bold text-warning font-monospace mb-2" t-esc="formatTime(state.myDurationMs)"/>
                            <div class="d-flex justify-content-center gap-3">
                                <t t-if="state.myRank">
                                    <span class="badge bg-info fs-5 px-3 py-2">
                                        Rank #<t t-esc="state.myRank"/>
                                    </span>
                                </t>
                                <t t-if="state.myPoints">
                                    <span class="badge bg-warning text-dark fs-5 px-3 py-2">
                                        +<t t-esc="state.myPoints"/> pts
                                    </span>
                                </t>
                            </div>
                        </div>

                        <!-- Other players status -->
                        <div class="card bg-secondary bg-opacity-25 border-light mb-4" style="max-width: 500px; margin: 0 auto;">
                            <div class="card-header bg-dark text-muted">
                                Waiting for other players...
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    <t t-foreach="state.game.players" t-as="player" t-key="player.user_id">
                                        <div class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center border-secondary">
                                            <span class="fw-bold"><t t-esc="player.user_name"/></span>
                                            <t t-if="player.state === 'finished'">
                                                <span class="badge bg-success">
                                                    <i class="fa fa-check me-1"/>
                                                    <t t-esc="formatTime(player.duration_ms)"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary">
                                                    <i class="fa fa-spinner fa-spin me-1"/>Playing...
                                                </span>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <t t-if="state.phase === 'round_results'">
                    <GameResults
                        game="state.game"
                        userId="user.userId"
                        mode="'round'"
                        onNextRound.bind="nextRound"
                        onPlayAgain.bind="playAgain"
                    />
                </t>
                <t t-if="state.phase === 'final_results'">
                    <GameResults
                        game="state.game"
                        userId="user.userId"
                        mode="'final'"
                        onNextRound.bind="nextRound"
                        onPlayAgain.bind="playAgain"
                    />
                </t>
            </div>
        </div>
    </t>
</templates>
