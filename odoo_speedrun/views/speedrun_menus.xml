<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level menu -->
    <menuitem id="menu_speedrun_root"
        name="Speedrun"
        web_icon="odoo_speedrun,static/description/icon.png"
        sequence="100"/>

    <!-- Play menu - client action -->
    <menuitem id="menu_speedrun_play"
        name="Play!"
        parent="menu_speedrun_root"
        action="speedrun_client_action"
        sequence="1"/>

    <!-- Tournaments (backend overview) -->
    <menuitem id="menu_speedrun_tournaments"
        name="Tournaments"
        parent="menu_speedrun_root"
        action="speedrun_tournament_action"
        sequence="3"/>

    <!-- Leaderboard -->
    <menuitem id="menu_speedrun_leaderboard"
        name="Leaderboard"
        parent="menu_speedrun_root"
        action="speedrun_leaderboard_action"
        sequence="5"/>

    <!-- Personal stats -->
    <menuitem id="menu_speedrun_my_stats_root"
        name="My Stats"
        parent="menu_speedrun_root"
        sequence="7"/>

    <menuitem id="menu_speedrun_my_profile"
        name="My Profile"
        parent="menu_speedrun_my_stats_root"
        action="speedrun_profile_action_my"
        sequence="1"/>

    <menuitem id="menu_speedrun_my_best_times"
        name="My Best Times"
        parent="menu_speedrun_my_stats_root"
        action="speedrun_personal_best_action_my"
        sequence="2"/>

    <menuitem id="menu_speedrun_my_elo"
        name="My ELO Progression"
        parent="menu_speedrun_my_stats_root"
        action="speedrun_elo_history_action_my"
        sequence="3"/>

    <!-- All player profiles -->
    <menuitem id="menu_speedrun_profiles"
        name="Players"
        parent="menu_speedrun_root"
        action="speedrun_profile_action_all"
        sequence="8"/>

    <!-- History -->
    <menuitem id="menu_speedrun_history"
        name="Game History"
        parent="menu_speedrun_root"
        action="speedrun_game_action"
        sequence="10"/>

    <!-- Configuration -->
    <menuitem id="menu_speedrun_config"
        name="Configuration"
        parent="menu_speedrun_root"
        sequence="90"
        groups="group_speedrun_manager,base.group_system"/>

    <menuitem id="menu_speedrun_tasks"
        name="Tasks"
        parent="menu_speedrun_config"
        action="speedrun_task_action"
        sequence="1"/>

    <menuitem id="menu_speedrun_task_import"
        name="Import Tasks"
        parent="menu_speedrun_config"
        action="speedrun_task_import_action"
        sequence="4"/>

    <menuitem id="menu_speedrun_task_groups"
        name="Task Groups"
        parent="menu_speedrun_config"
        action="speedrun_task_group_action"
        sequence="2"/>

    <menuitem id="menu_speedrun_badges"
        name="Badges"
        parent="menu_speedrun_config"
        action="speedrun_badge_action"
        sequence="3"/>

    <menuitem id="menu_speedrun_matchmaking"
        name="Matchmaking Queue"
        parent="menu_speedrun_config"
        action="speedrun_matchmaking_action"
        sequence="3"/>
</odoo>
