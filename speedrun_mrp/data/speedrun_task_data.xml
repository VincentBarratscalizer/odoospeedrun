<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="task_create_bom" model="speedrun.task">
            <field name="name">Create a bill of materials with 2 components</field>
            <field name="description">Create a Bill of Materials for a product with at least 2 component lines. Go to Manufacturing > Products > Bills of Materials.</field>
            <field name="target_model">mrp.bom</field>
            <field name="verification_method">python</field>
            <field name="verification_code">
boms = env['mrp.bom'].with_user(uid).search([
    ('create_uid', '=', uid),
    ('create_date', '>=', start_time),
])
result = any(len(b.bom_line_ids) >= 2 for b in boms)
            </field>
            <field name="difficulty">medium</field>
            <field name="required_modules">mrp</field>
        </record>

        <record id="task_create_mo" model="speedrun.task">
            <field name="name">Create a manufacturing order</field>
            <field name="description">Create a new manufacturing order for any product. It can stay as a draft.</field>
            <field name="target_model">mrp.production</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">mrp</field>
        </record>

        <record id="task_confirm_mo" model="speedrun.task">
            <field name="name">Confirm a manufacturing order</field>
            <field name="description">Create a manufacturing order and confirm it. The MO must no longer be in draft state.</field>
            <field name="target_model">mrp.production</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"],["state","not in",["draft","cancel"]]]</field>
            <field name="difficulty">hard</field>
            <field name="required_modules">mrp</field>
        </record>

        <record id="task_create_equipment" model="speedrun.task">
            <field name="name">Register an equipment</field>
            <field name="description">Create a new equipment in the Maintenance app with a name.</field>
            <field name="target_model">maintenance.equipment</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">maintenance</field>
        </record>

        <record id="task_create_maintenance_request" model="speedrun.task">
            <field name="name">Create a maintenance request</field>
            <field name="description">Create a new maintenance request in the Maintenance app.</field>
            <field name="target_model">maintenance.request</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">maintenance</field>
        </record>

        <record id="task_create_quality_alert" model="speedrun.task">
            <field name="name">Create a quality alert</field>
            <field name="description">Create a new quality alert in the Quality app.</field>
            <field name="target_model">quality.alert</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">quality_control</field>
        </record>

        <record id="task_create_quality_point" model="speedrun.task">
            <field name="name">Create a quality control point</field>
            <field name="description">Create a new quality control point in the Quality app (pick any operation type).</field>
            <field name="target_model">quality.point</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">medium</field>
            <field name="required_modules">quality_control</field>
        </record>

        <record id="task_create_repair" model="speedrun.task">
            <field name="name">Create a repair order</field>
            <field name="description">Create a new repair order in the Repairs app for any product.</field>
            <field name="target_model">repair.order</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">repair</field>
        </record>

        <record id="task_confirm_repair" model="speedrun.task">
            <field name="name">Confirm a repair order</field>
            <field name="description">Create a repair order and confirm it. It must be in "Confirmed" state.</field>
            <field name="target_model">repair.order</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"],["state","=","confirmed"]]</field>
            <field name="difficulty">medium</field>
            <field name="required_modules">repair</field>
        </record>

        <record id="task_create_eco" model="speedrun.task">
            <field name="name">Create an engineering change order</field>
            <field name="description">Create a new Engineering Change Order (ECO) in the PLM app.</field>
            <field name="target_model">mrp.eco</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="difficulty">medium</field>
            <field name="required_modules">mrp_plm</field>
        </record>
    </data>
</odoo>
