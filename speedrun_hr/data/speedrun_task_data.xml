<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="task_create_employee" model="speedrun.task">
            <field name="name">Create an employee</field>
            <field name="description">Create a new employee with a name, a job title, and a work email address.</field>
            <field name="target_model">hr.employee</field>
            <field name="verification_method">python</field>
            <field name="verification_code">
result = env['hr.employee'].with_user(uid).search_count([
    ('create_uid', '=', uid),
    ('create_date', '>=', start_time),
    ('job_title', '!=', False),
    ('work_email', '!=', False),
]) >= 1
            </field>
            <field name="difficulty">easy</field>
            <field name="required_modules">hr</field>
        </record>

        <record id="task_create_3_employees" model="speedrun.task">
            <field name="name">Create 3 employees</field>
            <field name="description">Create 3 new employees. Each one just needs a name - be fast!</field>
            <field name="target_model">hr.employee</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"]]</field>
            <field name="verification_count">3</field>
            <field name="difficulty">easy</field>
            <field name="required_modules">hr</field>
        </record>

