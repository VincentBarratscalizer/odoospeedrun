<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         speedrun.equipment — List & Form
         ============================================================ -->
    <record id="speedrun_equipment_list" model="ir.ui.view">
        <field name="name">speedrun.equipment.list</field>
        <field name="model">speedrun.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment" decoration-muted="rarity == 'common'" decoration-info="rarity == 'rare'" decoration-warning="rarity == 'epic'" decoration-danger="rarity == 'legendary'">
                <field name="icon" string=""/>
                <field name="name"/>
                <field name="rarity"/>
                <field name="category"/>
                <field name="stat_hp"/>
                <field name="stat_atk"/>
                <field name="stat_def"/>
                <field name="stat_spd"/>
                <field name="stat_crit"/>
                <field name="price" string="Prix 💰"/>
                <field name="set_ids" widget="many2many_tags"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="speedrun_equipment_form" model="ir.ui.view">
        <field name="name">speedrun.equipment.form</field>
        <field name="model">speedrun.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="icon" style="font-size:2rem; margin-right:8px;"/>
                            <field name="name" placeholder="Item name…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rarity"/>
                            <field name="category"/>
                            <field name="price" string="Prix boutique 💰"
                                   help="Laisser à 0 pour un prix par défaut basé sur la rareté."/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <separator string="Statistiques de combat"/>
                    <group>
                        <group>
                            <field name="stat_hp"/>
                            <field name="stat_atk"/>
                            <field name="stat_def"/>
                        </group>
                        <group>
                            <field name="stat_spd"/>
                            <field name="stat_crit"/>
                        </group>
                    </group>
                    <separator string="Panoplies"/>
                    <field name="set_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_equipment_action" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">speedrun.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================
         speedrun.equipment.set — List & Form
         ============================================================ -->
    <record id="speedrun_equipment_set_list" model="ir.ui.view">
        <field name="name">speedrun.equipment.set.list</field>
        <field name="model">speedrun.equipment.set</field>
        <field name="arch" type="xml">
            <list string="Panoplies">
                <field name="sequence" widget="handle"/>
                <field name="icon" string=""/>
                <field name="name"/>
                <field name="title"/>
                <field name="score_bonus"/>
                <field name="item_count" string="Items"/>
            </list>
        </field>
    </record>

    <record id="speedrun_equipment_set_form" model="ir.ui.view">
        <field name="name">speedrun.equipment.set.form</field>
        <field name="model">speedrun.equipment.set</field>
        <field name="arch" type="xml">
            <form string="Panoplie">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="icon" style="font-size:2rem; margin-right:8px;"/>
                            <field name="name" placeholder="Set name…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="score_bonus"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <separator string="Items in this set"/>
                    <field name="item_ids">
                        <list>
                            <field name="icon" string=""/>
                            <field name="name"/>
                            <field name="rarity"/>
                            <field name="category"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_equipment_set_action" model="ir.actions.act_window">
        <field name="name">Panoplies</field>
        <field name="res_model">speedrun.equipment.set</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================
         speedrun.shop.day — Daily shop
         ============================================================ -->
    <record id="speedrun_shop_day_list" model="ir.ui.view">
        <field name="name">speedrun.shop.day.list</field>
        <field name="model">speedrun.shop.day</field>
        <field name="arch" type="xml">
            <list string="Daily Shops">
                <field name="date"/>
                <field name="item_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="speedrun_shop_day_form" model="ir.ui.view">
        <field name="name">speedrun.shop.day.form</field>
        <field name="model">speedrun.shop.day</field>
        <field name="arch" type="xml">
            <form string="Daily Shop">
                <sheet>
                    <div class="oe_title"><h1><field name="date"/></h1></div>
                    <separator string="Articles proposés"/>
                    <field name="item_ids">
                        <list>
                            <field name="icon" string=""/>
                            <field name="name"/>
                            <field name="rarity"/>
                            <field name="category"/>
                            <field name="price"/>
                        </list>
                    </field>
                    <separator string="Achats"/>
                    <field name="purchase_ids">
                        <list>
                            <field name="user_id"/>
                            <field name="equipment_id"/>
                            <field name="price_paid"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_shop_day_action" model="ir.actions.act_window">
        <field name="name">Daily Shops</field>
        <field name="res_model">speedrun.shop.day</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
