<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="task_create_invoice" model="speedrun.task">
            <field name="name">Create a customer invoice</field>
            <field name="description">Create a new customer invoice with at least one invoice line. It can remain as a draft.</field>
            <field name="target_model">account.move</field>
            <field name="verification_method">python</field>
            <field name="verification_code">
result = env['account.move'].with_user(uid).search_count([
    ('create_uid', '=', uid),
    ('create_date', '>=', start_time),
    ('move_type', '=', 'out_invoice'),
    ('invoice_line_ids', '!=', False),
]) >= 1
            </field>
            <field name="difficulty">easy</field>
            <field name="required_modules">account</field>
        </record>

        <record id="task_post_invoice" model="speedrun.task">
            <field name="name">Post a customer invoice</field>
            <field name="description">Create a customer invoice and confirm (post) it. The invoice must be in "Posted" state.</field>
            <field name="target_model">account.move</field>
            <field name="verification_method">domain</field>
            <field name="verification_domain">[["create_uid","=","__uid__"],["create_date",">=","__game_start__"],["move_type","=","out_invoice"],["state","=","posted"]]</field>
            <field name="difficulty">hard</field>
            <field name="required_modules">account</field>
        </record>

        <record id="task_create_vendor_bill" model="speedrun.task">
            <field name="name">Create a vendor bill</field>
            <field name="description">Create a vendor bill (supplier invoice) with at least one line. It can remain as draft.</field>
            <field name="target_model">account.move</field>
            <field name="verification_method">python</field>
            <field name="verification_code">
result = env['account.move'].with_user(uid).search_count([
    ('create_uid', '=', uid),
    ('create_date', '>=', start_time),
    ('move_type', '=', 'in_invoice'),
    ('invoice_line_ids', '!=', False),
]) >= 1
            </field>
            <field name="difficulty">medium</field>
            <field name="required_modules">account</field>
        </record>
    </data>
</odoo>
