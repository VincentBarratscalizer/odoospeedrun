<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== Profile ==================== -->
    <record id="speedrun_profile_view_list" model="ir.ui.view">
        <field name="name">speedrun.profile.list</field>
        <field name="model">speedrun.profile</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="user_id"/>
                <field name="elo" decoration-bf="1"/>
                <field name="peak_elo" optional="show"/>
                <field name="level"/>
                <field name="level_title"/>
                <field name="xp"/>
                <field name="coins" optional="show"/>
                <field name="games_played"/>
                <field name="games_won"/>
                <field name="win_rate" widget="progressbar"/>
                <field name="best_time_ms" optional="show"/>
                <field name="badge_count"/>
            </list>
        </field>
    </record>

    <record id="speedrun_profile_view_form" model="ir.ui.view">
        <field name="name">speedrun.profile.form</field>
        <field name="model">speedrun.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="user_id" readonly="1"/></h1>
                        <h3><field name="level_title" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Rating &amp; Wallet">
                            <field name="elo"/>
                            <field name="peak_elo"/>
                            <field name="xp"/>
                            <field name="level" readonly="1"/>
                            <field name="coins"/>
                        </group>
                        <group string="Arena / Clan">
                            <field name="arena_rating"/>
                            <field name="arena_peak"/>
                            <field name="power" readonly="1"/>
                            <field name="gear_score" readonly="1"/>
                            <field name="clan_id"/>
                            <field name="clan_role"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_collection_ids">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="rarity" readonly="1"/>
                                    <field name="count"/>
                                    <field name="fusion_level"/>
                                    <field name="item_score" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chests" name="chests">
                            <field name="chest_ids">
                                <list editable="bottom">
                                    <field name="rarity"/>
                                    <field name="state"/>
                                    <field name="source"/>
                                    <field name="equipment_id"/>
                                    <field name="create_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Classes" name="classes">
                            <group>
                                <group string="Class levels (coin-upgraded passive)">
                                    <field name="class_level_peripheral"/>
                                    <field name="class_level_display"/>
                                    <field name="class_level_badge"/>
                                    <field name="class_level_module"/>
                                    <field name="class_level_tech"/>
                                    <field name="class_level_desk"/>
                                </group>
                                <group string="Domain ratings (computed)">
                                    <field name="class_rating_peripheral" readonly="1"/>
                                    <field name="class_rating_display" readonly="1"/>
                                    <field name="class_rating_badge" readonly="1"/>
                                    <field name="class_rating_module" readonly="1"/>
                                    <field name="class_rating_tech" readonly="1"/>
                                    <field name="class_rating_desk" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Daily &amp; Gacha" name="daily">
                            <group>
                                <group string="Weekly reward streak">
                                    <field name="loot_sequence_id"/>
                                    <field name="loot_day"/>
                                    <field name="loot_last_claim"/>
                                </group>
                                <group string="Gacha">
                                    <field name="pity_epic_counter"/>
                                    <field name="pity_legendary_counter"/>
                                    <field name="last_daily_chest"/>
                                    <field name="arena_fights_today"/>
                                    <field name="arena_fights_date"/>
                                </group>
                            </group>
                            <separator string="Daily challenge history"/>
                            <field name="daily_result_ids" readonly="1">
                                <list>
                                    <field name="daily_id"/>
                                    <field name="completed"/>
                                    <field name="duration_ms"/>
                                    <field name="finish_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="PvE Bosses" name="pve">
                            <field name="boss_progress_ids" readonly="1">
                                <list>
                                    <field name="boss_id"/>
                                    <field name="combat_done"/>
                                    <field name="epreuve_done"/>
                                    <field name="epreuve_count"/>
                                    <field name="attempts_left"/>
                                    <field name="cooldown_until"/>
                                    <field name="defeated" decoration-success="defeated"/>
                                    <field name="defeated_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Games" name="games">
                            <field name="game_player_ids" readonly="1">
                                <list decoration-info="state in ('waiting','playing')" decoration-muted="state == 'dnf'">
                                    <field name="game_id"/>
                                    <field name="state"/>
                                    <field name="score"/>
                                    <field name="round_wins"/>
                                    <field name="duration_ms"/>
                                    <field name="finish_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Task History" name="task_history">
                            <field name="round_result_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="game_id"/>
                                    <field name="round_number"/>
                                    <field name="task_id"/>
                                    <field name="rank"/>
                                    <field name="duration_ms"/>
                                    <field name="points"/>
                                </list>
                            </field>
                        </page>
                        <page string="Best Times" name="best_times">
                            <field name="personal_best_ids" readonly="1">
                                <list>
                                    <field name="task_id"/>
                                    <field name="best_time_ms"/>
                                    <field name="avg_time_ms"/>
                                    <field name="attempts"/>
                                    <field name="wins"/>
                                    <field name="last_played"/>
                                </list>
                            </field>
                        </page>
                        <page string="Per-Task ELO" name="task_elo">
                            <field name="task_score_ids" readonly="1">
                                <list>
                                    <field name="task_id"/>
                                    <field name="elo"/>
                                    <field name="peak_elo"/>
                                    <field name="rounds_played"/>
                                    <field name="rounds_won"/>
                                    <field name="best_time_ms"/>
                                    <field name="last_played"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shop Purchases" name="shop">
                            <field name="shop_purchase_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="equipment_id"/>
                                    <field name="price_paid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Statistics" name="stats">
                            <group>
                                <field name="games_played"/>
                                <field name="games_won"/>
                                <field name="win_rate" widget="progressbar"/>
                                <field name="rounds_played"/>
                                <field name="rounds_won"/>
                                <field name="best_time_ms"/>
                                <field name="arena_wins"/>
                                <field name="arena_losses"/>
                            </group>
                        </page>
                        <page string="Badges" name="badges">
                            <field name="badge_award_ids" readonly="1">
                                <list>
                                    <field name="badge_id"/>
                                    <field name="game_id"/>
                                    <field name="create_date" string="Earned On"/>
                                </list>
                            </field>
                        </page>
                        <page string="ELO History" name="elo_history">
                            <field name="elo_history_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="game_id"/>
                                    <field name="elo_before"/>
                                    <field name="elo_change"/>
                                    <field name="elo_after"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_profile_action_my" model="ir.actions.act_window">
        <field name="name">My Stats</field>
        <field name="res_model">speedrun.profile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <record id="speedrun_profile_action_all" model="ir.actions.act_window">
        <field name="name">Player Profiles</field>
        <field name="res_model">speedrun.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Personal Bests ==================== -->
    <record id="speedrun_personal_best_view_list" model="ir.ui.view">
        <field name="name">speedrun.personal.best.list</field>
        <field name="model">speedrun.personal.best</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="task_id"/>
                <field name="user_id" optional="hide"/>
                <field name="best_time_ms" decoration-success="1"/>
                <field name="avg_time_ms"/>
                <field name="attempts"/>
                <field name="wins"/>
                <field name="last_played"/>
            </list>
        </field>
    </record>

    <record id="speedrun_personal_best_action_my" model="ir.actions.act_window">
        <field name="name">My Best Times</field>
        <field name="res_model">speedrun.personal.best</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <!-- ==================== Per-Task ELO ==================== -->
    <record id="speedrun_task_score_view_list" model="ir.ui.view">
        <field name="name">speedrun.task.score.list</field>
        <field name="model">speedrun.task.score</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="task_id, elo desc">
                <field name="task_id"/>
                <field name="user_id"/>
                <field name="elo" decoration-bf="1"/>
                <field name="peak_elo" optional="show"/>
                <field name="rounds_played"/>
                <field name="rounds_won"/>
                <field name="best_time_ms"/>
                <field name="last_played"/>
            </list>
        </field>
    </record>

    <record id="speedrun_task_score_action" model="ir.actions.act_window">
        <field name="name">Task Rankings</field>
        <field name="res_model">speedrun.task.score</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_task': 1}</field>
    </record>

    <record id="speedrun_task_score_view_search" model="ir.ui.view">
        <field name="name">speedrun.task.score.search</field>
        <field name="model">speedrun.task.score</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id"/>
                <field name="user_id"/>
                <filter name="group_task" string="Task" context="{'group_by': 'task_id'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== ELO History ==================== -->
    <record id="speedrun_elo_history_view_list" model="ir.ui.view">
        <field name="name">speedrun.elo.history.list</field>
        <field name="model">speedrun.elo.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="user_id" optional="hide"/>
                <field name="game_id"/>
                <field name="elo_before"/>
                <field name="elo_change" decoration-success="elo_change &gt; 0" decoration-danger="elo_change &lt; 0"/>
                <field name="elo_after"/>
            </list>
        </field>
    </record>

    <record id="speedrun_elo_history_view_graph" model="ir.ui.view">
        <field name="name">speedrun.elo.history.graph</field>
        <field name="model">speedrun.elo.history</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="create_date" interval="day"/>
                <field name="elo_after" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="speedrun_elo_history_action_my" model="ir.actions.act_window">
        <field name="name">My ELO Progression</field>
        <field name="res_model">speedrun.elo.history</field>
        <field name="view_mode">graph,list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <!-- ==================== Badges ==================== -->
    <record id="speedrun_badge_view_list" model="ir.ui.view">
        <field name="name">speedrun.badge.list</field>
        <field name="model">speedrun.badge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="description"/>
                <field name="criteria_type"/>
                <field name="threshold"/>
                <field name="xp_reward"/>
                <field name="award_count"/>
            </list>
        </field>
    </record>

    <record id="speedrun_badge_view_form" model="ir.ui.view">
        <field name="name">speedrun.badge.form</field>
        <field name="model">speedrun.badge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" class="oe_inline" style="width: 60px;"/>
                            <field name="name" class="oe_inline" placeholder="Badge Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="criteria_type"/>
                            <field name="threshold"/>
                            <field name="xp_reward"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="award_count"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speedrun_badge_action" model="ir.actions.act_window">
        <field name="name">Badges</field>
        <field name="res_model">speedrun.badge</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Matchmaking queue (admin monitoring) ==================== -->
    <record id="speedrun_matchmaking_view_list" model="ir.ui.view">
        <field name="name">speedrun.matchmaking.queue.list</field>
        <field name="model">speedrun.matchmaking.queue</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Queued At"/>
                <field name="user_id"/>
                <field name="elo"/>
                <field name="state"/>
                <field name="game_id"/>
            </list>
        </field>
    </record>

    <record id="speedrun_matchmaking_action" model="ir.actions.act_window">
        <field name="name">Matchmaking Queue</field>
        <field name="res_model">speedrun.matchmaking.queue</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
